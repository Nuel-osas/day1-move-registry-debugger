# Sui network (testnet for the class)
SUI_NETWORK=testnet
# Your MVR name for the vault package, e.g. @trenchsui/vault
MVR_NAME=@yourname/vault
# Fallback when MVR_NAME is not registered yet
VAULT_PACKAGE_ID=0x...
VAULT_OBJECT_ID=0x...
# Optional: private key (suiprivkey...) if not using the active sui client keystore
SUI_PRIVATE_KEY=
